# Public site URL (used for canonical URLs, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://enlacepolymers.com

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_ID=

# Where enquiry form submissions are forwarded (optional).
# Works with Google Apps Script web app, Zapier/Make webhooks, or your CRM's inbound webhook.
# If empty, leads are written to .data/leads.jsonl locally and printed to the server console.
LEAD_WEBHOOK_URL=
